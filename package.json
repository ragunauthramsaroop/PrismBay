{
  "name": "team-site-template",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "bun run serve.ts",
    "publish": "bash ./publish.sh",
    "go-live": "bash ./go-live.sh",
    "format": "prettier --write .",
    "migrate": "bun run scripts/migrate.ts",
    "seed-admin": "bun run scripts/seed-admin.ts",
    "automation:email-worker": "bun run scripts/run-automation-email-worker.ts",
    "test:youtube-gate": "node --test scripts/youtube-publishing-guard.test.mjs scripts/youtube-publishing-gateway.test.mjs scripts/youtube-publishing-entrypoint.test.mjs",
    "youtube:preflight": "node scripts/youtube-publishing-preflight.mjs",
    "youtube:studio-check": "node scripts/install-youtube-studio-gate.mjs --check",
    "claude:free": "node scripts/claude-9router-auto.mjs --launch",
    "claude:free:check": "node scripts/claude-9router-auto.mjs --verify",
    "claude:free:setup": "node scripts/claude-9router-auto.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/bcrypt": "^1.10.7",
    "@oslojs/crypto": "^1.0.1",
    "@tanstack/react-router": "^1.158.1",
    "@tanstack/react-start": "^1.158.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.18.1",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5"
  }
}
