    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "matrix-js-sdk": "44.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.3",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
