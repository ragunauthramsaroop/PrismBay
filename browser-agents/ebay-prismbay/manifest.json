{
  "manifest_version": 3,
  "name": "PrismBay eBay Local Agent",
  "version": "1.1.0",
  "description": "Zero-cost local PrismBay assistant for CJ-to-eBay authorization and verified eBay draft filling.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://*.ebay.com/*",
    "https://ebay.com/*",
    "https://cjdropshipping.com/*",
    "https://www.cjdropshipping.com/*",
    "https://clean.prismbayai.com/*"
  ],
  "action": {
    "default_title": "PrismBay eBay Agent",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.ebay.com/*", "https://ebay.com/*"],
      "js": ["content.js", "ebay-auth.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://cjdropshipping.com/*", "https://www.cjdropshipping.com/*"],
      "js": ["cj-auth.js"],
      "run_at": "document_idle"
    }
  ]
}
